# Revalidate pages and application modules so releases cannot remain stale.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Server code is deployed to Cloud Functions, never served by the static website.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:functions|tests|node_modules)(?:/|$) - [F,L]
</IfModule>
<FilesMatch "^\.env(?:\..*)?$">
  Require all denied
</FilesMatch>
